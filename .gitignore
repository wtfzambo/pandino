__pycache__/
.pytest_cache/
# Raw pi transcripts are hundreds of MB; keep the CSVs, reviews, and judge verdicts.
bench/*/results/raw/*.jsonl
bench/*/results/raw/*.err

# Pandino installed into itself: the agent definitions live in agents/, so the
# generated copies are noise. The playbooks are sources and stay tracked.
.pi/
.pandino/*
!.pandino/playbooks/
